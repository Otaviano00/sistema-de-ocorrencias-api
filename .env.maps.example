# Acrescente ao .env, preservando as variáveis já existentes.
# Política do serviço público: https://operations.osmfoundation.org/policies/nominatim/
# Para coordenadas pessoais/confidenciais, use instância própria ou provedor apropriado.
NOMINATIM_API_URL=https://nominatim.openstreetmap.org/reverse
# Substitua o contato de exemplo por um contato real da aplicação.
NOMINATIM_USER_AGENT="zelar-api/1.0 (contato: seu-email@example.com)"
NOMINATIM_TIMEOUT_MS=5000
