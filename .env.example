# Copie para .env (`cp .env.example .env`). Todas as variáveis têm padrão no
# docker-compose.yml, então o .env é opcional para `make up`.

# Banco (usado pelo container db e para montar a DATABASE_URL da api no compose)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ocorrencias
DB_PORT=5432

# Portas publicadas no host
API_PORT=3000
WEB_PORT=4200

# Origens liberadas no CORS da API (lista separada por vírgula)
CORS_ORIGIN=http://localhost:4200

# Usada ao rodar a API/seed fora do Docker (no compose ela é sobrescrita para o host "db")
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}?schema=public

# E-mail (Resend)
RESEND_API_URL=https://api.resend.com
RESEND_API_TOKEN=

# Usado para criar o token JWT
JWT_SECRET=jwt_token